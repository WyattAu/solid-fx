{
  "name": "solid-bits",
  "version": "0.1.0",
  "description": "Animated, interactive SolidJS components. A Solid port of react-bits (DavidHDev/react-bits).",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Wyatt Au <wyatt_au@protonmail.com>",
  "repository": "github:WyattAu/solid-bits",
  "scripts": {
    "dev": "bun run gen:docs && astro dev",
    "gen:index": "node scripts/gen-index.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "check": "tsc --noEmit",
    "build": "bun run gen:index && bun run gen:docs && astro sync && bun run check && astro build",
    "test": "bun run gen:index && vitest run",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "contract": "bash scripts/check-contract.sh",
    "coverage": "bun run gen:index && vitest run --coverage",
    "ci": "bun run build && bun run test && bun run fmt:check && bun run lint && bun run contract"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.3",
    "@use-gesture/vanilla": "^10.2.27",
    "gsap": "^3.13.0",
    "matter-js": "^0.20.0",
    "motion": "^12.23.12",
    "ogl": "^1.0.11",
    "solid-js": "^1.9.5",
    "three": "^0.180.0",
    "vgpu": "^0.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/solid-js": "^7.0.2",
    "@astrojs/starlight": "^0.42.8",
    "@biomejs/biome": "^2.5.0",
    "@tailwindcss/vite": "^4.0.3",
    "@types/matter-js": "^0.19.8",
    "@types/three": "^0.180.0",
    "@vitest/coverage-v8": "^3.0.8",
    "astro": "^7.4.4",
    "jsdom": "^30.1.3",
    "jsrepo": "^3.8.2",
    "sharp": "^0.34.2",
    "tailwindcss": "^4.0.3",
    "typescript": "^5.7.3",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^3.0.8"
  }
}
